{
  "format": "invariants-registry/1",
  "entries": [
    {
      "id": "app-no-web-storage",
      "statement": "No identifier reference to localStorage, sessionStorage, indexedDB or caches under src/ — an app runs at an opaque origin where even reading them throws SecurityError, so a typeof guard cannot catch it.",
      "sources": [
        "grove/CLAUDE.md Hard rules 8",
        "content/specs/BROWSER_CAPABILITIES_SPEC.mdx"
      ],
      "scope": {
        "repos": "apps",
        "paths": [
          "src/**/*.{ts,tsx,js,jsx,mjs,cjs}"
        ]
      },
      "enforcement": "check",
      "added": "2026-10-16"
    },
    {
      "id": "app-main-tsx-inert",
      "statement": "src/main.tsx is for local dev/build only: it imports no CSS file and nothing from @immediately-run/sdk — anything the rendered tree needs must be reachable from src/App.tsx, which the platform renders.",
      "sources": [
        "grove/CLAUDE.md Hard rules 1-2"
      ],
      "scope": {
        "repos": "apps",
        "paths": [
          "src/main.tsx"
        ]
      },
      "enforcement": "check",
      "added": "2026-10-16"
    },
    {
      "id": "app-no-remote-css-import",
      "statement": "No @import of an http(s) URL in src/**/*.css — a remote font or stylesheet breaks offline in every stance and is blocked under compiled dispatch; fonts are declared assets the engine resolves.",
      "sources": [
        "R3-315",
        "grove/CLAUDE.md Hard rules 6"
      ],
      "scope": {
        "repos": "apps",
        "paths": [
          "src/**/*.css"
        ]
      },
      "enforcement": "check",
      "added": "2026-10-16"
    },
    {
      "id": "workflow-secret-pair-gated-together",
      "statement": "A workflow if: that references one member of a declared secret pair (DEPLOY_APP_ID / DEPLOY_APP_PRIVATE_KEY) must reference both — gating the Pages-token mint on the id alone runs it with an empty key.",
      "sources": [
        "escape-classification E01",
        "findings-log 2026-09-15"
      ],
      "scope": {
        "repos": "all",
        "paths": [
          ".github/workflows/*.{yml,yaml}"
        ]
      },
      "enforcement": "check",
      "added": "2026-10-16"
    },
    {
